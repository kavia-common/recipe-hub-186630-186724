# Example environment variables for recipe_app_frontend
# Copy this file to `.env` and adjust values as necessary.

# PUBLIC_INTERFACE
# VITE_API_BASE takes precedence for API base URL
VITE_API_BASE=https://api.example.com

# PUBLIC_INTERFACE
# Fallback backend URL if VITE_API_BASE is not set
VITE_BACKEND_URL=https://backend.example.com

# Optional frontend URL (used for redirects, metadata, etc.)
VITE_FRONTEND_URL=http://localhost:3000

# Optional WebSocket URL (not required for current features)
VITE_WS_URL=ws://localhost:3001

# Feature flags, comma-separated. Include 'mockData' to use local mock dataset instead of calling real APIs.
VITE_FEATURE_FLAGS=mockData

# Other optional build flags from container_env (safe defaults)
VITE_NODE_ENV=development
VITE_NEXT_TELEMETRY_DISABLED=1
VITE_ENABLE_SOURCE_MAPS=1
VITE_PORT=3000
VITE_TRUST_PROXY=0
VITE_LOG_LEVEL=info
VITE_HEALTHCHECK_PATH=/health
VITE_EXPERIMENTS_ENABLED=0
